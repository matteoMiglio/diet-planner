{
  "name": "@diet/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "eval:plan": "tsx eval/eval-plan.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@date-fns/tz": "1.5.0",
    "@diet/shared": "workspace:*",
    "@hono/node-server": "2.1.6",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "postgres": "3.4.9",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
