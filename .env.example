# Copy to .env. Never commit .env.

# --- Development (pnpm dev / pnpm test) ---
DATABASE_URL=postgres://diet:diet@127.0.0.1:5432/diet
TEST_DATABASE_URL=postgres://diet:diet@127.0.0.1:5432/diet_test

# --- Production (docker compose on the VM) ---
# Postgres password for the compose stack.
POSTGRES_PASSWORD=change-me
# Port the app binds on the host's loopback; `tailscale serve` proxies to it.
APP_PORT=8080
TZ_DEFAULT=Europe/Rome

# iOS Shortcuts (weight + Tanita CSV ingest). At least 32 characters: openssl rand -hex 32
INGEST_TOKEN=

# Web push reminders. Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:you@example.com or an https:// URL
VAPID_SUBJECT=

# Off-site backups: restic to Oracle Cloud Object Storage (S3-compatible).
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
RESTIC_REPOSITORY=s3:https://<namespace>.compat.objectstorage.<region>.oraclecloud.com/<bucket>/diet-planner
RESTIC_PASSWORD=change-me-long-random
# OCI Customer Secret Key (Profile -> Customer secret keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# OCI region, e.g. eu-frankfurt-1
AWS_DEFAULT_REGION=
